{
    "name": "pixelperfectat/magento2-module-store-pickup-inventory",
    "description": "Store pickup for MSI: pickup-active inventory sources as pickup locations, salability per source, and shipping from the pickup source",
    "license": "MIT",
    "type": "magento2-module",
    "require": {
        "magento/framework": "^103.0",
        "magento/module-inventory-api": "^1.2",
        "magento/module-inventory-configuration-api": "^1.2",
        "magento/module-inventory-in-store-pickup-api": "^1.1",
        "magento/module-inventory-sales-api": "^1.2",
        "magento/module-inventory-shipping": "^1.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1",
        "php": "^8.3",
        "pixelperfectat/magento2-module-store-pickup": "^0.1"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.2.2"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "PixelPerfect\\StorePickupInventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PixelPerfect\\StorePickupInventory\\Test\\": "Test/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "mage-os/*": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test",
            "@infection"
        ],
        "ci:validate": "@composer validate --no-check-publish",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "infection": "infection --with-uncovered --min-msi=85 --min-covered-msi=90 --threads=max",
        "lint": "parallel-lint --exclude vendor --exclude generated --exclude .superpowers .",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
